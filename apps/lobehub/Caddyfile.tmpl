{
	admin off
	auto_https off
}

:3211 {
{{sign_in_launch}}
	handle /__mu3lab_lobehub_health {
		respond 200
	}
	handle_path /lobe-assets/* {
		reverse_proxy rustfs:9000
	}
	handle {
		# Only reachable through the private HTTPS route; without this LobeChat
		# advertises http:// sign-in links that browsers and Mu3Lab reject.
		reverse_proxy app:3210 {
			header_up X-Forwarded-Proto https
		}
	}
}
