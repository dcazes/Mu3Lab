{
  "oauth": {
    "enabled": true,
    "issuerUrl": "{{discovery_url}}",
    "clientId": "{{IMMICH_OIDC_CLIENT_ID}}",
    "clientSecret": "{{IMMICH_OIDC_CLIENT_SECRET}}",
    "scope": "openid email profile",
    "signingAlgorithm": "RS256",
    "autoRegister": true,
    "autoLaunch": true,
    "buttonText": "Login with Authentik",
    "roleClaim": "mu3lab_role",
    "mobileOverrideEnabled": true,
    "mobileRedirectUri": "{{origin}}/api/oauth/mobile-redirect"
  },
  "passwordLogin": {
    "enabled": {{IMMICH_PASSWORD_LOGIN_ENABLED}}
  },
  "ffmpeg": {
    "accel": "{{IMMICH_VIDEO_ACCEL}}",
    "accelDecode": true
  }
}
