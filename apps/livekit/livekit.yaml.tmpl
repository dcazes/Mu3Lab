# LiveKit server settings, rendered by Mu3Lab at install (keys and this server's tailnet address).
port: 7880
rtc:
  # WebRTC over TCP, for networks that block UDP.
  tcp_port: 7881
  # All media on one UDP port instead of a 10,000-port range.
  udp_port: 7882
  # Browsers reach the media ports on the tailnet address; never ask a public STUN server.
  use_external_ip: false
  node_ip: {{tailnet_ip}}
  # Also offer the container-network addresses. The voice agent sits on Mu3Lab's private
  # network, which cannot reach the tailnet address, so without this its media never connects
  # (it joins the room, then times out). Browsers keep using the tailnet address.
  advertise_internal_ip: true
keys:
  # Quoted: a key of only digits would otherwise read as a number.
  "{{LIVEKIT_API_KEY}}": "{{LIVEKIT_API_SECRET}}"
logging:
  level: info
