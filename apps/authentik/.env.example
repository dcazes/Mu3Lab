# Image versions are pinned in docker-compose.yml.
AUTHENTIK_SECRET_KEY=generate_during_bootstrap
AUTHENTIK_POSTGRESQL__PASSWORD=generate_during_bootstrap
# Automated first start: the installer writes a password hash, never the password.
AUTHENTIK_BOOTSTRAP_EMAIL=owner@example.test
AUTHENTIK_BOOTSTRAP_PASSWORD_HASH=generate_during_bootstrap
AUTHENTIK_BOOTSTRAP_TOKEN=generate_during_bootstrap
# Email and password hash are removed after setup; the API token is kept.
