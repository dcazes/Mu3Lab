:19476 {
	bind 127.0.0.1
	@api_token {
		path /api/*
		header GROCY-API-KEY "*"
	}
	route {
		handle @api_token {
			reverse_proxy 127.0.0.1:8003 {
				header_up -X-Mu3lab-User
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Host {http.request.hostport}
			}
		}
		handle {
			reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:9001
			forward_auth 127.0.0.1:9001 {
				uri /outpost.goauthentik.io/auth/caddy
				header_up Host {http.request.hostport}
				header_up X-Forwarded-Host {http.request.hostport}
				header_up X-Forwarded-Proto https
				copy_headers X-Authentik-Username
				trusted_proxies private_ranges
			}
			redir /login* / 302
			reverse_proxy 127.0.0.1:8003 {
				# Set replaces the client header; deletes run after sets.
				header_up X-Mu3lab-User {http.request.header.X-Authentik-Username}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Host {http.request.hostport}
			}
		}
	}
}
