# Mu3Lab :: .env.example
# WHAT:  Template for the repo-root secrets file. Copy to `.env` (or let
#        install.sh create it) and fill nothing in by hand — values are
#        generated, never invented.
# WHY:   The real `.env` is mode 0600 and gitignored (see .gitignore).
#        install.sh only ADDS missing keys; it never overwrites existing ones.
# DEBUG: `stat -c %a .env` must print 600. `grep -c TOKEN .env` lists keys
#        without showing values.

# Control-plane bearer token for the dashboard API (hex, 32 bytes).
MU3LAB_CTL_TOKEN=

# Shared token authenticating the local Caddy -> dashboard hop (Step 2 use;
# written now so core/ingress/.env can copy it in Step 1c).
MU3LAB_INGRESS_TOKEN=
