# Generated runtime variant used only after the operator creates the Mu3Lab
# Authentik proxy application and verifies anonymous access is denied.
{
	auto_https off
	admin off
}

:19460 {
	# Also accept private requests from the Homarr Docker bridge for its
	# server-side lifecycle widgets. This is the bridge gateway only; the
	# public listener remains Tailscale Serve on the loopback binding.
	bind 127.0.0.1 172.21.0.1
	handle /__mu3lab_caddy_health {
		respond 204
	}
	# Homarr custom widgets execute on the Homarr server, so they do not carry
	# the operator's browser cookie. This narrow route has its own bearer token
	# and still requires the trusted Caddy-to-control-plane hop token.
	@homarr_control path /api/v1/homarr/*
	handle @homarr_control {
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Mu3Lab-Proxy-Token {env.MU3LAB_INGRESS_TOKEN}
		}
	}
	handle {
			route {
			reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:9001
			forward_auth 127.0.0.1:9001 {
				uri /outpost.goauthentik.io/auth/caddy
				header_up Host {http.request.host}
				header_up X-Forwarded-Host {http.request.host}
				header_up X-Forwarded-Proto https
				copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Entitlements X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
				trusted_proxies private_ranges
			}
			reverse_proxy 127.0.0.1:8787 {
				header_up X-Mu3Lab-Proxy-Token {env.MU3LAB_INGRESS_TOKEN}
			}
		}
	}
}

:19461 {
	bind 127.0.0.1
	reverse_proxy 127.0.0.1:9001 {
		header_up Host {http.request.host}
		header_up X-Forwarded-Host {http.request.host}
		header_up X-Forwarded-Proto https
	}
}

:19462 {
	bind 127.0.0.1
	reverse_proxy 127.0.0.1:8081 {
		header_up X-Forwarded-Proto https
	}
}


:19463 {
	bind 127.0.0.1
	route {
		reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:9001
		forward_auth 127.0.0.1:9001 {
			uri /outpost.goauthentik.io/auth/caddy
			header_up Host {http.request.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
			copy_headers X-Authentik-Email X-Authentik-Name X-Authentik-Groups
			trusted_proxies private_ranges
		}
		reverse_proxy 127.0.0.1:8084 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Mu3Lab-Email {http.request.header.X-Authentik-Email}
			header_up X-Mu3Lab-Name {http.request.header.X-Authentik-Name}
			header_down -X-Frame-Options
			header_down Content-Security-Policy "frame-ancestors https://*.ts.net:8446"
		}
	}
}

# LiteLLM's administration UI is an operator-facing service. Authentik
# protects the private route; LiteLLM continues to enforce its own API keys.
:19471 {
	bind 127.0.0.1
	route {
		reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:9001
		forward_auth 127.0.0.1:9001 {
			uri /outpost.goauthentik.io/auth/caddy
			header_up Host {http.request.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
			trusted_proxies private_ranges
		}
		reverse_proxy 127.0.0.1:4000 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {http.request.host}
		}
	}
}

# FreeLLMAPI keeps its own native dashboard session. Tailnet publication is
# private, while the upstream login remains the final authentication layer.
:19472 {
	bind 127.0.0.1
	reverse_proxy 127.0.0.1:3001 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {http.request.host}
	}
}
