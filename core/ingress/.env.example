# Mu3Lab :: core/ingress/.env.example
# WHAT:  Template for core/ingress/.env (minimal Caddyfile needs no secrets;
#        this file reserves the keys Step 2's forward-auth will require).
# WHY:   Committed examples document shape; real values are generated into
#        0600 .env files nobody commits (see .gitignore).
# DEBUG: `diff <(cut -d= -f1 .env.example) <(cut -d= -f1 .env)` shows drift.

# Shared token authenticating the local Caddy -> dashboard hop (used when
# forward-auth + dashboard_headers arrive; reserved now so the file exists).
MU3LAB_INGRESS_TOKEN=replace_with_hex32
