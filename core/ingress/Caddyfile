# Mu3Lab :: core/ingress/Caddyfile
# WHAT:  Minimal starter: :19460 proxies to the real dashboard (:8787).
# WHY:   TLS terminates at Tailscale Serve (tailnet), so Caddy stays plain
#        HTTP on loopback with auto_https off. Forward-auth blocks, tailnet
#        host vars, and per-app routes arrive with the apps (later phases) —
#        adding them now would ship untested security config.
# DEBUG: `docker exec <caddy> caddy validate --config /etc/caddy/Caddyfile
#        --adapter caddyfile`; `curl -i http://127.0.0.1:19460/__mu3lab_caddy_health`.
{
	auto_https off
	admin off
}

# Dashboard entrypoint. Tailscale Serve terminates tailnet HTTPS and sends only
# loopback HTTP here; no application container binds to the LAN.
# Match any Host header arriving from Tailscale Serve while still binding only
# to loopback. A host-specific site address would return an empty response
# when the tailnet hostname is forwarded by Serve.
:19460 {
	bind 127.0.0.1
	handle /__mu3lab_caddy_health {
		respond 204
	}
	handle {
		reverse_proxy 127.0.0.1:8787
	}
}

# Authentik first-run UI. It is intentionally not protected by forward auth:
# Authentik is the identity provider and its own first administrator is created
# in its official UI after bootstrap.
:19461 {
	bind 127.0.0.1
	reverse_proxy 127.0.0.1:9001 {
		header_up X-Forwarded-Proto https
	}
}

# Vaultwarden remains its own application authentication boundary. Its remote
# route is private to the tailnet; it is never exposed through MCP.
:19462 {
	bind 127.0.0.1
	reverse_proxy 127.0.0.1:8081 {
		header_up X-Forwarded-Proto https
	}
}
